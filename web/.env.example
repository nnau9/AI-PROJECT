# Скопируйте в .env.local и заполните при подключении backend.
# Пусто = контент из локальных JSON (shared/data), заявки работают как заглушка.

# Базовый URL API контента. Ожидается GET {URL}/content/{name}
VITE_API_BASE_URL=

# Endpoint для POST заявок (JSON). Пусто = демонстрационная заглушка, данные никуда не отправляются.
VITE_LEADS_ENDPOINT=
