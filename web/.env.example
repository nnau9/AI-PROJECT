# Скопируйте в .env.local и заполните при подключении backend.
# Пусто = контент из локальных JSON (shared/data), заявки работают как заглушка.

# Базовый URL API контента. Ожидается GET {URL}/content/{name}
VITE_API_BASE_URL=

# Endpoint для POST заявок (JSON). Пусто = демонстрационная заглушка, данные никуда не отправляются.
VITE_LEADS_ENDPOINT=

# Адрес сервера чата-помощника из папки server/, например http://localhost:8787/api/chat
# (POST JSON { question, history, context } → { answer, links?, handoff? }).
# Пусто = помощник отвечает в браузере по материалам сайта, вопросы никуда не отправляются.
# Ключ ANTHROPIC_API_KEY сюда НЕ писать: VITE_* попадают в код сайта. Ключ — только в server/.env.
VITE_CHAT_ENDPOINT=
