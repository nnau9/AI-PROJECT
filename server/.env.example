# Скопируйте в server/.env (файл в .gitignore) или задайте в настройках хостинга.
# Ключи — только на сервере. В коде сайта и в VITE_* переменных их быть не должно.

# ---------- Модель ----------
# Достаточно одного ключа. Если заданы оба, используется Gemini (или укажите LLM_PROVIDER).

# Google Gemini — бесплатный ключ: https://aistudio.google.com → Get API key
GEMINI_API_KEY=
# Модели по порядку (через запятую): если первая перегружена, ответит следующая.
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Поиск Google: auto — пробовать, а без квоты (бесплатный тариф Gemini 3) отвечать по сайту; on; off
GEMINI_SEARCH=auto

# Anthropic Claude — платный ключ: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5-5
CHAT_EFFORT=low
# Сайты для поиска Claude (через запятую). Пусто — официальные сайты J-1, посольств США и спонсоров.
SEARCH_DOMAINS=

# gemini или anthropic. Пусто — выбирается по заданному ключу.
LLM_PROVIDER=

# ---------- Сервер ----------
PORT=8787
# С каких сайтов разрешены запросы (через запятую). * — с любых.
# Например: https://nnau9.github.io,http://localhost:5173
ALLOWED_ORIGINS=*
# Сколько вопросов с одного IP за 10 минут
RATE_LIMIT_PER_10_MIN=20
