# Скопируйте в server/.env (файл в .gitignore) или задайте в настройках хостинга.

# Ключ Anthropic API — только на сервере. В коде сайта и в VITE_* переменных его быть не должно.
ANTHROPIC_API_KEY=

# Порт сервера
PORT=8787

# С каких сайтов разрешены запросы (через запятую). * — с любых.
# Например: https://nnato.kz,http://localhost:5173
ALLOWED_ORIGINS=*

# Модель и глубина размышлений (low — быстрее и дешевле, подходит для чата)
CHAT_MODEL=claude-opus-5-5
CHAT_EFFORT=low

# Сайты для поиска в интернете (через запятую). Пусто — официальные сайты J-1, посольства США и спонсоров.
SEARCH_DOMAINS=

# Сколько вопросов с одного IP за 10 минут
RATE_LIMIT_PER_10_MIN=20
